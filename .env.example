# meluni - ornek ortam degiskenleri
#
# Bu dosya sablondur ve repoya girer. Gercek degerler ASLA buraya yazilmaz.
# Sunucuda gercek dosya su yolda durur:  <DEPLOY_PATH>/shared/.env
# Yerelde calisirken bu dosyayi ".env" olarak kopyalayip doldurun.

APP_ENV=production
APP_DEBUG=false
# APP_URL=https://meluni.com.tr
# PORT=3000

# --- Veritabani ---
# DATABASE_URL=

# --- Deploy davranisi (sunucudaki shared/.env icinde okunur) ---
# post-deploy.sh yigini package.json / composer.json / requirements.txt
# dosyalarina bakarak kendi tespit eder. Ezmek isterseniz:
# APP_STACK=node          # node | php | python | static

# Deploy sonrasi servisi yeniden baslatmak icin BIRINI doldurun.
# Ikisi de bossa kod sunucuya kopyalanir ama servis eski kodu calistirmaya
# devam eder (statik sitelerde sorun degil).
# APP_SERVICE=meluni      # systemd servis adi (parolasiz sudo gerekir)
# PM2_APP=meluni          # PM2 uygulama adi

# Doldurulursa deploy sonrasi bu adres kontrol edilir; cevap vermezse
# release otomatik olarak geri alinir.
# HEALTH_URL=http://127.0.0.1:3000/

# --- Yerelden ./scripts/deploy.sh calistirirken ---
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PORT=22
# DEPLOY_PATH=/home/<kullanici>/apps/meluni
# SSH_KEY=~/.ssh/meluni_deploy
