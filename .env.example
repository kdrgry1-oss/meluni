# meluni - ornek ortam degiskenleri
#
# Bu dosya sablondur ve repoya girer. Gercek degerler ASLA buraya yazilmaz.
# Sunucuda gercek dosya su yolda durur:  <DEPLOY_PATH>/shared/.env
# Yerelde calisirken bu dosyayi ".env" olarak kopyalayip doldurun.

APP_ENV=production
APP_DEBUG=false
# APP_URL=https://ornek.com
# PORT=3000

# --- Veritabani ---
# DATABASE_URL=

# --- Deploy ayarlari (yerelden ./scripts/deploy.sh calistirirken) ---
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PORT=22
# DEPLOY_PATH=/home/<kullanici>/apps/meluni
# SSH_KEY=~/.ssh/meluni_deploy
