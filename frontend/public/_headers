# Cloudflare Pages / Netlify _headers
# Amaç: "eski hali bir an görünüp sonra yenisi geliyor" sorununu çözmek.
#
# index.html ASLA cache'lenmez -> her ziyarette en güncel sürüm gelir,
# hash'li statik dosyalar (main.[hash].js/css, /static/*) sonsuza dek cache'lenir
# (içerik değişince dosya adı/hash değiştiği için güvenli ve hızlı).

# --- GÜVENLİK BAŞLIKLARI (tüm yollar) ---
# CSP hariç bu başlıklar analitik/pixel'leri KIRMAZ; hemen aktif.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  # CSP: aşağıdaki satırı, sitede kullanılan TÜM 3. parti host'lar (GTM, Google,
  # Meta, TikTok, iyzico, fontlar, api.facette.com.tr) test edildikten SONRA aç.
  # Yanlış CSP storefront'u/analitiği kırabileceğinden varsayılan KAPALI bırakıldı.
  # Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.facette.com.tr https://www.google-analytics.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# HTML her zaman taze
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Hash'li build dosyaları: kalıcı cache
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Diğer hash'li JS/CSS
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
